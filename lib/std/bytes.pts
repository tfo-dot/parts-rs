"Parts Bytes Module"

return |>
    pad: fun(buf, alignment) {
        let blen = __bytes_len(buf);
        let rem = blen % alignment;
        if rem > 0 {
            let pad_count = alignment - rem;
            let p = 0;
            for p < pad_count {
                __bytes_push(buf, 0);
                p = p + 1;
            }
        }
        
        return Option::None;
    }
<|;
