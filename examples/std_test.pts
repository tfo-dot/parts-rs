let std = import `../lib/std.pts`;

std.println("--- Math Module ---");
let math = std.math;
std.println("PI: ", math.PI);
std.println("sin(PI/2): ", math.sin(math.PI / 2));
std.println("Random: ", math.rand());

std.println("\n--- Sys Module ---");
let sys = std.sys;
std.println("Current Time: ", sys.time());
std.println("User: ", sys.env("USER"));

std.println("\n--- String Module ---");
let str = std.str;
let msg = "Hello, Parts!";
let len = str.len;
std.println("Length of '", msg, "': ", msg.len());

"Using UFCS for string joining"
let join = str.join;
let greeting = "Hello ".join("World");
std.println(greeting);
