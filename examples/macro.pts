let std = import `@std/std.pts`;

part example {
  (select @col in @db) => { std.println("Selecting ", @col, " of ", @db); }
  (@db) => { std.println("Just a general identifier match lol ", @db); }
  (@) => { std.println("Fallback for when anything else matches ", @); } 
}

example!{ select "data" in "life" };

example!{ "data" };

example!{ "data", "time" }